# ─────────────────────────────────────────────────────────────
# CodeSync .gitignore
# Rule of thumb: commit source, config templates and lockfiles;
# never commit installed packages, build output, secrets or local junk.
# ─────────────────────────────────────────────────────────────

# ── Dependencies (re-created by `npm run install:all`) ────────
node_modules/
.pnpm-store/
.yarn/
.npm/

# ── Build output (re-created by `npm run build`) ─────────────
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/

# ── Secrets / local settings ─────────────────────────────────
# .env files hold MONGO_URI passwords etc. Only the *.example templates are committed.
.env
.env.*
!.env.example
*.local

# ── Deployment CLI link folders (contain project/site IDs) ───
.vercel/
.netlify/

# ── Logs & debug output ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test / coverage output ───────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/

# ── Caches & temp files ──────────────────────────────────────
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
tmp/
temp/
*.tmp
*.bak
*.orig

# ── Editors / IDEs ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Operating system junk ────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# ── Local MongoDB data (if you run mongod with a data dir here) ─
data/db/
mongo-data/
