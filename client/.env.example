# Leave EMPTY for local development and for single-server deploys
# (Vite proxy / Express serve everything on one origin).
#
# For a split deploy (frontend on Vercel/Netlify, backend on a VM), set the
# backend's public HTTPS URL. It is baked into the build, so set it in the
# Vercel/Netlify dashboard (Environment Variables) and redeploy after changing it.
VITE_BACKEND_URL=
