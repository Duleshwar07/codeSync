# Port the Express / WebSocket server listens on
PORT=4000

# MongoDB connection string (docker-compose.yml starts one on this address)
MONGO_URI=mongodb://127.0.0.1:27017/codesync

# Frontend origin(s) allowed to use the API and WebSockets (comma-separated,
# "*" wildcard allowed). Production example:
#   CLIENT_ORIGIN=https://codesync.vercel.app,https://codesync-*.vercel.app
CLIENT_ORIGIN=http://localhost:5180

# Sandbox limits for every code run
RUN_TIMEOUT_MS=10000
RUN_MEMORY=128m
RUN_CPUS=0.5
RUN_MAX_OUTPUT_BYTES=65536

# Debug: keep finished sandbox containers so they stay visible in Docker Desktop
# (clean up with: docker container prune --filter label=codesync=run)
RUN_KEEP_CONTAINERS=false
